<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Description>MariaDB/MySQL .NET Aspire hosting integration for Squill. Build and deploy a Squill DACPAC against a MySQL/MariaDB resource from your Aspire AppHost.</Description>
        <PackageTags>squill;aspire;dotnet-aspire;mariadb;mysql;dacpac;sql;deployment</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.MySql" Version="13.4.6" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Squill.Aspire.Hosting\Squill.Aspire.Hosting.csproj" />
      <ProjectReference Include="..\Squill.Provider.MariaDb\Squill.Provider.MariaDb.csproj" />
    </ItemGroup>

</Project>
