<Project>

  <!--
    Squill.Sdk — MSBuild project SDK for .squillproj projects.

    Imported implicitly at the TOP of a .squillproj. Establishes default properties
    and the default item globs (declarative .sql files become SquillCompile items),
    mirroring how Microsoft.NET.Sdk manages Compile/None items so the project file
    stays minimal.
  -->

  <PropertyGroup>
    <!-- Identify this as a Squill project so targets/tasks can branch on it. -->
    <UsingSquillSdk>true</UsingSquillSdk>

    <!-- Selects the provider (and thus the SQL dialect/parser) the DACPAC is built for and
         is recorded in the DACPAC so `squill deploy` targets the right database engine.
         Supported: Postgresql (default), or MariaDb / MySql. -->
    <SquillProviderName Condition="'$(SquillProviderName)' == ''">Postgresql</SquillProviderName>

    <!-- The minimum target engine major version the DACPAC is built for (like SSDT's target
         platform), e.g. 16 for PostgreSQL or 11 for MariaDB/MySQL. Recorded in the DACPAC and
         enforced on `squill deploy`: deploying to an older server fails. Empty = no constraint. -->
    <SquillTargetVersion Condition="'$(SquillTargetVersion)' == ''"></SquillTargetVersion>

    <!-- Standard bin/obj layout so `dotnet build` drops the .dacpac in bin\ like SSDT. -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <!-- Trailing slashes are OS-agnostic here: MSBuild normalizes '/' on Windows, and
         paths handed to tasks are normalized again below. -->
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin/</BaseOutputPath>
    <OutputPath Condition="'$(OutputPath)' == ''">$(BaseOutputPath)$(Configuration)/</OutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">obj/</BaseIntermediateOutputPath>
    <IntermediateOutputPath Condition="'$(IntermediateOutputPath)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>

    <!-- The data-tier application name/version recorded in the DACPAC metadata. -->
    <SquillDacName Condition="'$(SquillDacName)' == ''">$(MSBuildProjectName)</SquillDacName>
    <SquillDacVersion Condition="'$(SquillDacVersion)' == ''">1.0.0.0</SquillDacVersion>

    <!-- The DACPAC file Squill produces, e.g. bin\Debug\MyDatabase.dacpac. -->
    <SquillDacpacFileName Condition="'$(SquillDacpacFileName)' == ''">$(MSBuildProjectName).dacpac</SquillDacpacFileName>
    <SquillDacpacPath Condition="'$(SquillDacpacPath)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(OutputPath)', '$(SquillDacpacFileName)'))</SquillDacpacPath>

    <EnableDefaultSquillItems Condition="'$(EnableDefaultSquillItems)' == ''">true</EnableDefaultSquillItems>
  </PropertyGroup>

  <!-- Default include glob: every .sql file under the project is a compile input,
       excluding build output. Projects can opt out with EnableDefaultSquillItems=false
       and declare SquillCompile items by hand. -->
  <ItemGroup Condition="'$(EnableDefaultSquillItems)' == 'true'">
    <SquillCompile Include="**\*.sql"
                   Exclude="$(BaseOutputPath)**;$(BaseIntermediateOutputPath)**;$(DefaultItemExcludes)" />
  </ItemGroup>

</Project>
