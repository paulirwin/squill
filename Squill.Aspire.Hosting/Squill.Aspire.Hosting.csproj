<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>true</IsPackable>
        <Description>.NET Aspire hosting integration for Squill. A provider-neutral core that lets an Aspire AppHost build and deploy a Squill DACPAC as part of the application model. Use the provider-specific Squill.Aspire.Hosting.PostgreSQL or Squill.Aspire.Hosting.MariaDb package.</Description>
        <PackageTags>squill;aspire;dotnet-aspire;dacpac;sql;deployment</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting" Version="13.4.6"/>
        <!-- Compile-time only: MSBuildLocator loads the real assemblies from the .NET SDK at
             runtime, and they must not sit next to the consuming app or they are bound in
             preference to the located ones. -->
        <PackageReference Include="Microsoft.Build" Version="18.8.2" ExcludeAssets="runtime"/>
        <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Squill.Dacpac\Squill.Dacpac.csproj" />
    </ItemGroup>

</Project>
