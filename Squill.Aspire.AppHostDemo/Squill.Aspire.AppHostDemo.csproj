<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>9416d1b7-cd3d-4d52-9b95-bfe98c23aa81</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.MySql" Version="13.4.6" />
      <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\samples\MariaDbSampleDatabase\MariaDbSampleDatabase.squillproj" />
      <ProjectReference Include="..\samples\PostgresSampleDatabase\PostgresSampleDatabase.squillproj" />
      <ProjectReference Include="..\Squill.Aspire.Hosting.MariaDb\Squill.Aspire.Hosting.MariaDb.csproj" IsAspireProjectResource="false" />
      <ProjectReference Include="..\Squill.Aspire.Hosting.PostgreSQL\Squill.Aspire.Hosting.PostgreSQL.csproj" IsAspireProjectResource="false" />
    </ItemGroup>

    <!--
      The referenced .squillproj samples build a DACPAC using an MSBuild task from
      Squill.Build.dll, which their SDK loads via a relative Import invisible to the
      project graph. The solution's <BuildDependency> orders Squill.Build first for the
      solution build, but that ordering does not extend to this project's ProjectReference
      edges: when the AppHost builds its referenced squillprojs, they can run before
      Squill.Build exists and fail with MSB4062. A bare .squillproj cannot carry its own
      ProjectReference ordering (it lacks the common build targets), so enforce it here —
      the AppHost is a normal SDK project — by building Squill.Build before this project's
      references are resolved and built. Guarded by Exists() so it is a no-op if the source
      project is ever absent. -->
    <Target Name="EnsureSquillBuildBeforeReferences"
            BeforeTargets="ResolveProjectReferences"
            Condition="Exists('..\Squill.Build\Squill.Build.csproj')">
      <MSBuild Projects="..\Squill.Build\Squill.Build.csproj"
               Targets="Build"
               Properties="Configuration=$(Configuration)" />
    </Target>

</Project>
