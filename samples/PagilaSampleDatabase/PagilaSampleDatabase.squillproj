<Project>

  <!--
    The Pagila sample database — the PostgreSQL port of the well-known Sakila
    DVD-rental schema — expressed declaratively as a Squill project. Building it
    produces bin\<Configuration>\PagilaSampleDatabase.dacpac from the .sql files
    in this folder.

    Unlike the smaller PostgresSampleDatabase, this project is a deliberately
    ambitious, real-world schema. It exercises the full surface a production
    Postgres schema uses — enum and domain types, identity keys, foreign keys
    (including a circular staff<->store reference), multi-column and GiST indexes,
    tsvector full-text search, array columns, PL/pgSQL and SQL functions, an
    aggregate, and triggers — so it doubles as a broad end-to-end exercise of the
    Postgres provider. Some of those features are not yet supported by Squill; the
    integration tests for this sample record exactly which (see
    Squill.IntegrationTests/Postgres/PagilaSampleTest).

    Schema source: the BSD-licensed Sakila/Pagila schema from https://github.com/jOOQ/sakila
    (the same source the Postgres parser tests use). See LICENSE.txt in this folder.

    In a consuming repo you would reference the published SDK by name and version:

        <Project Sdk="Squill.Sdk/0.0.1">
        </Project>

    Here in the Squill source tree we import the SDK from its source location by
    relative path so the sample builds against the local, uninstalled SDK.
  -->

  <Import Project="..\..\Squill.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <SquillProviderName>Postgresql</SquillProviderName>
    <!-- The minimum PostgreSQL major version this DACPAC targets (like SSDT's target
         platform). Recorded in the DACPAC and enforced on `squill deploy`. -->
    <SquillTargetVersion>16</SquillTargetVersion>
  </PropertyGroup>

  <Import Project="..\..\Squill.Sdk\Sdk\Sdk.targets" />

</Project>
